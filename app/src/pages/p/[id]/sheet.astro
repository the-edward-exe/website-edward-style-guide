---
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/Button.astro';
import QuizDialog from '../../../components/QuizDialog.astro';
import { getProfile, beginLooks } from '../../../lib/profiles';
import { nextPath } from '../../../lib/questionnaire';
import { startLooksJob, startLookImages } from '../../../lib/jobs';
import { listLookImages } from '../../../lib/look-images';
import { aiMode } from '../../../lib/ai/mode';
import { STOPPED } from '../../../lib/stop';

let profile = await getProfile(Astro.params.id!);
if (!profile) return Astro.rewrite('/404');
if (!profile.photoPath) return Astro.redirect(`/p/${profile.id}/photo`);

// Profiles that finished the questionnaire before the looks existed get theirs on first visit.
if (profile.looksStatus === 'none' && nextPath(profile) === `/p/${profile.id}/sheet`) {
  const attempt = await beginLooks(profile.id, ['pending', 'ready', 'failed']);
  if (attempt !== null) startLooksJob(profile.id, attempt);
  profile = (await getProfile(profile.id))!;
}
// Looks written before they had pictures get them now. Does nothing once the pictures are claimed.
startLookImages(profile.id);

const { looks, looksStatus, looksError } = profile;
const lookImages = await listLookImages(profile);
const version = (path: string | null | undefined) => path?.match(/look-(\d+)/)?.[1] ?? '';
// Writing the looks, or pictures still to come (a look with no row yet is about to be claimed).
const looksBusy = looksStatus === 'pending' || (looksStatus === 'ready' && profile.sheetStatus === 'ready'
  && (lookImages.length < (looks?.looks.length ?? 0) || lookImages.some((i) => i.status === 'pending')));

const { sheetStatus: status, sheetError } = profile;
const demo = aiMode().gemini === 'demo';
const v = profile.attempt;
---
<Base title="Character sheet">
  <div class="head">
    <span class="label">Character sheet · {profile.name}</span>
    <h1>{status === 'ready' ? 'Is this you?' : status === 'failed' ? (sheetError === STOPPED ? 'Sheet stopped' : 'The sheet didn’t work') : 'Building your character sheet'}</h1>
    <p class="label">Every outfit you try on uses this sheet. Check the face, hair and build.</p>
    {demo && <p class="note-warn">Demo mode: add GEMINI_API_KEY to .env for real sheets</p>}
  </div>

  <div class="pair">
    <figure>
      <div class="frame"><img src={`/api/p/${profile.id}/image/photo?v=${v}`} alt={`${profile.name}'s photo`} /></div>
      <figcaption class="label">Your photo</figcaption>
    </figure>

    <figure class="sheet">
      <div class:list={['frame', { waiting: status !== 'ready' }]} id="sheetFrame" data-status={status}>
        {status === 'ready' && <img src={`/api/p/${profile.id}/image/sheet?v=${v}`} alt={`${profile.name}'s character sheet`} />}
        {status === 'pending' && <span class="label pulse">Building. This takes 20 to 60 seconds.</span>}
        {status === 'failed' && <span class="error">{sheetError}</span>}
      </div>
      <figcaption class="label">Character sheet</figcaption>
    </figure>
  </div>

  <div class="actions">
    {status === 'ready' && (
      <form method="post" action={`/api/p/${profile.id}/sheet/approve`}>
        <Button variant="primary">This is me</Button>
      </form>
    )}
    {status === 'pending' && (
      <form method="post" action={`/api/p/${profile.id}/stop`}>
        <input type="hidden" name="what" value="sheet" />
        <Button>Stop</Button>
      </form>
    )}
    {status !== 'pending' && (
      <form method="post" action={`/api/p/${profile.id}/sheet/retry`}>
        <Button>Try again</Button>
      </form>
    )}
    <a class="label dl" href={`/p/${profile.id}/photo`}>Use a different photo</a>
  </div>

  {looksStatus !== 'none' && (
    <section class="looks" aria-labelledby="looksTitle">
      <div class="lhead">
        <span class="label">10 looks for you</span>
        <h2 id="looksTitle">Picked for your skin tone and style</h2>
        {looksStatus === 'ready' && (
          <p class="label">
            Each look is made on your character sheet. {status === 'ready' ? 'Pictures take a minute or two.' : 'Pictures start once your sheet is ready.'}
            <a class="dl" id="lookZip" href={`/api/p/${profile.id}/looks/zip`} hidden={!lookImages.some((i) => i.status === 'ready')}>Download all</a>
          </p>
        )}
        <div class="lactions">
          <button type="button" class="taste" data-edit-step="3">Change your taste</button>
          <form method="post" action={`/api/p/${profile.id}/stop`} id="lookStop" hidden={!looksBusy}>
            <input type="hidden" name="what" value="looks" />
            <Button>Stop</Button>
          </form>
        </div>
        <p class="label">Pick different looks, colors or things to avoid. Your 10 looks and their pictures are made again.</p>
      </div>
      {looksStatus === 'pending' && (
        <div class="lgrid">
          {Array.from({ length: 10 }, () => <div class="lcard"><div class="lframe waiting"><span class="label pulse">Writing your looks</span></div></div>)}
        </div>
      )}
      {looksStatus === 'failed' && (
        <div class="lfail">
          <span class="error">{looksError}</span>
          <form method="post" action={`/api/p/${profile.id}/looks`}><Button>Try again</Button></form>
        </div>
      )}
      {looksStatus === 'ready' && looks && (
        <ol class="lgrid">
          {looks.looks.map((l, i) => {
            const img = lookImages.find((x) => x.idx === i);
            // No row yet while the claim is in flight: show it as being made if it can be.
            const state = img?.status ?? (status === 'ready' ? 'pending' : 'waiting');
            const n = i + 1;
            return (
              <li class="lcard" id={`look-${n}`}>
                <div class:list={['lframe', { waiting: state !== 'ready' }]} data-n={n} data-status={state} data-v={version(img?.path)} data-alt={`${profile.name} wearing ${l.name}`}>
                  {state === 'ready' && <img src={`/api/p/${profile.id}/looks/${n}?v=${version(img?.path)}`} alt={`${profile.name} wearing ${l.name}`} loading="lazy" />}
                  {state === 'pending' && <span class="label pulse">Dressing you</span>}
                  {state === 'waiting' && <span class="label">{status === 'failed' ? 'Needs your character sheet' : 'Waiting for your sheet'}</span>}
                  {state === 'failed' && (
                    <>
                      <span class="error">{img?.error}</span>
                      <form method="post" action={`/api/p/${profile.id}/looks/${n}`}><Button>Try again</Button></form>
                    </>
                  )}
                </div>
                <div class="lmeta">
                  <span class="label">{String(n).padStart(2, '0')} · {l.style}</span>
                  <a class="label dl" href={`/api/p/${profile.id}/looks/${n}?download=1`} hidden={state !== 'ready'}>Download</a>
                </div>
                <span class="lname">{l.name}</span>
                <ul class="pieces">{l.pieces.map((pc) => <li><i style={`background:${pc.hex}`} />{pc.item}<em>{pc.color}</em></li>)}</ul>
                <p class="why">{l.why}</p>
              </li>
            );
          })}
        </ol>
      )}
    </section>
  )}
  {looksStatus !== 'none' && <QuizDialog mode="edit" profileId={profile.id} name={profile.name} answers={profile.answers} startStep={3} />}
</Base>

<script define:vars={{ id: profile.id, status, looksStatus }}>
  // The sheet or the written looks finishing reloads the page. Look pictures swap in place as each one lands.
  const frames = () => [...document.querySelectorAll('.lframe[data-n]')];
  const busy = () => status === 'pending' || looksStatus === 'pending' || frames().some((f) => f.dataset.status === 'pending');

  function paint(frame, img) {
    // A failure needs the server-rendered Try again button.
    if (img.status === 'failed') return location.reload();
    const n = frame.dataset.n;
    frame.dataset.status = img.status;
    frame.dataset.v = img.v ?? '';
    frame.classList.toggle('waiting', img.status !== 'ready');
    frame.replaceChildren();
    if (img.status === 'ready') {
      const el = document.createElement('img');
      el.src = `/api/p/${id}/looks/${n}?v=${img.v}`;
      el.alt = frame.dataset.alt;
      frame.append(el);
    } else if (img.status === 'pending') {
      const el = document.createElement('span');
      el.className = 'label pulse';
      el.textContent = 'Dressing you';
      frame.append(el);
    }
    const dl = frame.parentElement.querySelector('.lmeta a');
    if (dl) dl.hidden = img.status !== 'ready';
  }

  const poll = async () => {
    const s = await fetch(`/api/p/${id}/status`).then((r) => r.json()).catch(() => null);
    if (s && (s.sheetStatus !== status || s.looksStatus !== looksStatus)) return location.reload();
    if (s) {
      for (const frame of frames()) {
        const img = s.lookImages[Number(frame.dataset.n) - 1];
        if (img && (img.status !== frame.dataset.status || (img.v ?? '') !== frame.dataset.v)) paint(frame, img);
      }
      const zip = document.getElementById('lookZip');
      if (zip) zip.hidden = !s.lookImages.some((i) => i.status === 'ready');
      const stop = document.getElementById('lookStop');
      if (stop && looksStatus === 'ready') stop.hidden = !frames().some((f) => f.dataset.status === 'pending');
    }
    if (busy()) setTimeout(poll, 3000);
  };
  if (busy()) setTimeout(poll, 3000);
</script>

<style>
  .head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 28px; }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--gap); align-items: start; max-width: min(820px, calc((100vh - 300px) * 1.15)); }
  figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .frame { background: var(--surface); aspect-ratio: 3 / 4; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .frame img { width: 100%; height: 100%; object-fit: contain; }
  .frame.waiting { background: var(--chip); padding: 24px; text-align: center; }
  .pulse { animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
  .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 24px; }
  .dl { margin-left: 8px; text-decoration: underline; text-underline-offset: 4px; }
  .dl:hover { color: var(--ink); }
  @media (max-width: 760px) { .pair { grid-template-columns: 1fr; } }

  .looks { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .lhead { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
  .lhead h2 { font-size: var(--text-lg); }
  .lactions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 6px; }
  .taste {
    font: 500 var(--text-xs)/1 var(--font); text-transform: uppercase; letter-spacing: var(--track-label);
    padding: 13px 22px; border: 0; background: var(--accent); color: var(--accent-ink); cursor: pointer;
  }
  .taste:hover { background: #774c32; }
  .lgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--gap); }
  .lcard { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .lframe { background: var(--surface); aspect-ratio: 3 / 4; display: flex; flex-direction: column; gap: 12px; align-items: center; justify-content: center; overflow: hidden; }
  .lframe :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .lframe :global(.pulse) { animation: pulse 1.6s ease-in-out infinite; }
  .lframe.waiting { background: var(--chip); padding: 16px; text-align: center; }
  .lmeta { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-top: 4px; }
  .lmeta .dl { margin-left: 0; }
  .lname { text-transform: uppercase; letter-spacing: var(--track-label); font-size: var(--text-sm); font-weight: 500; }
  .pieces { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: var(--text-xs); }
  .pieces li { display: flex; align-items: center; gap: 6px; }
  .pieces em { font-style: normal; color: var(--muted); }
  .pieces i { width: 10px; height: 10px; flex: none; border: 1px solid var(--line); }
  .why { margin: 0; font-size: var(--text-xs); color: var(--muted); }
  .lfail { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  @media (max-width: 1100px) { .lgrid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .lgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .lframe :global(.pulse) { animation: none; } }
</style>
