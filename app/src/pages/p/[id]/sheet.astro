---
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/Button.astro';
import { getProfile } from '../../../lib/profiles';
import { STEPS, stepComplete } from '../../../lib/questionnaire';
import { aiMode } from '../../../lib/ai/mode';
import { STOPPED } from '../../../lib/stop';

const profile = await getProfile(Astro.params.id!);
if (!profile) return Astro.rewrite('/404');

const { sheetStatus: status, sheetError, photoPath } = profile;
const demo = aiMode().gemini === 'demo';
const v = profile.attempt;
const uploadError = Astro.url.searchParams.get('error');
const openStep = STEPS.find((s) => !stepComplete(profile.answers, s.n));
const heading = !photoPath ? 'Add your photo'
  : status === 'ready' ? 'Is this you?'
  : status === 'failed' ? (sheetError === STOPPED ? 'Sheet stopped' : 'The sheet didn’t work')
  : 'Building your character sheet';
---
<Base title="Character sheet" profile={profile} current="sheet">
  <div class="head">
    <span class="label">Character sheet · {profile.name}</span>
    <h1>{heading}</h1>
    <p class="label">{photoPath ? 'Every outfit you try on uses this sheet. Check the face, hair and build.' : 'Front. Full body. Daylight. Plain background.'}</p>
    {demo && <p class="note-warn">Demo mode: add GEMINI_API_KEY to .env for real sheets</p>}
  </div>

  <div class="pair">
    <figure>
      <form method="post" action={`/api/p/${profile.id}/photo`} enctype="multipart/form-data">
        <label class="drop" id="drop" data-has={photoPath ? 'yes' : 'no'}>
          <img id="preview" src={photoPath ? `/api/p/${profile.id}/image/photo?v=${v}` : undefined} alt={`${profile.name}'s photo`} hidden={!photoPath} />
          <span class="prompt" id="prompt" hidden={!!photoPath}>
            <span class="label strong">Drag a photo here</span>
            <span class="label">or click to browse · JPG, PNG or WebP</span>
          </span>
          <input id="photoFile" type="file" name="photo" accept="image/jpeg,image/png,image/webp" aria-label={photoPath ? 'Use a different photo' : 'Choose your photo'} />
        </label>
        <noscript><Button variant="primary">Upload</Button></noscript>
      </form>
      <figcaption class="label">Your photo</figcaption>
      <p class="error" id="photoError" role="alert">{uploadError}</p>
    </figure>

    <figure class="sheet">
      <div class:list={['frame', { waiting: status !== 'ready' }]} id="sheetFrame" data-status={status}>
        {status === 'ready' && <img src={`/api/p/${profile.id}/image/sheet?v=${v}`} alt={`${profile.name}'s character sheet`} />}
        {status === 'pending' && <span class="label pulse">Building. This takes 20 to 60 seconds.</span>}
        {status === 'failed' && <span class="error">{sheetError}</span>}
        {status === 'none' && <span class="label">Your character sheet appears here</span>}
      </div>
      <figcaption class="label">Character sheet</figcaption>
    </figure>
  </div>

  {photoPath && (
    <div class="actions">
      {openStep && <Button variant="primary" href={`/p/${profile.id}/q/${openStep.n}`}>Next: the questions</Button>}
      {status === 'ready' && !openStep && (
        <form method="post" action={`/api/p/${profile.id}/sheet/approve`}>
          <Button variant="primary">This is me</Button>
        </form>
      )}
      {status === 'pending' && (
        <form method="post" action={`/api/p/${profile.id}/stop`}>
          <input type="hidden" name="what" value="sheet" />
          <Button>Stop</Button>
        </form>
      )}
      {status !== 'pending' && (
        <form method="post" action={`/api/p/${profile.id}/sheet/retry`}>
          <Button>Try again</Button>
        </form>
      )}
      <label class="label dl" for="photoFile">Use a different photo</label>
    </div>
  )}
</Base>

<script define:vars={{ id: profile.id, status }}>
  const drop = document.getElementById('drop');
  const input = document.getElementById('photoFile');
  const preview = document.getElementById('preview');
  const prompt = document.getElementById('prompt');
  const error = document.getElementById('photoError');

  async function upload(file) {
    error.textContent = '';
    preview.src = URL.createObjectURL(file);
    preview.hidden = false;
    prompt.hidden = true;
    drop.classList.add('busy');
    const body = new FormData();
    body.append('photo', file);
    const res = await fetch(`/api/p/${id}/photo`, { method: 'POST', body, headers: { Accept: 'application/json' } }).catch(() => null);
    const out = res ? await res.json().catch(() => null) : null;
    drop.classList.remove('busy');
    if (out?.ok) return location.assign(location.pathname);
    error.textContent = out?.error ?? 'UPLOAD FAILED. TRY AGAIN.';
  }

  input.addEventListener('change', () => input.files?.[0] && upload(input.files[0]));
  ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (e) => { const f = e.dataTransfer?.files?.[0]; if (f) upload(f); });
  // Stop a file dropped beside the box from opening in the tab.
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => e.preventDefault());

  // The sheet finishing reloads the page.
  const poll = async () => {
    const s = await fetch(`/api/p/${id}/status`).then((r) => r.json()).catch(() => null);
    if (s && s.sheetStatus !== status) return location.reload();
    setTimeout(poll, 3000);
  };
  if (status === 'pending') setTimeout(poll, 3000);
</script>

<style>
  .head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 28px; }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--gap); align-items: start; max-width: min(820px, calc((100vh - 300px) * 1.15)); }
  figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .drop { position: relative; aspect-ratio: 3 / 4; display: flex; align-items: center; justify-content: center; text-align: center; background: var(--chip); cursor: pointer; overflow: hidden; outline: 1px dashed var(--muted); outline-offset: -10px; }
  .drop[data-has=yes] { outline: none; background: var(--surface); }
  .drop:hover, .drop.over, .drop:focus-within { outline: 2px solid var(--ink); outline-offset: -2px; }
  .drop.busy img { opacity: 0.5; }
  .drop img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .prompt { display: flex; flex-direction: column; gap: 6px; padding: 0 16px; }
  .strong { color: var(--ink); }
  .error:empty { display: none; }
  .frame { background: var(--surface); aspect-ratio: 3 / 4; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .frame img { width: 100%; height: 100%; object-fit: contain; }
  .frame.waiting { background: var(--chip); padding: 24px; text-align: center; }
  .pulse { animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
  .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 24px; }
  .dl { margin-left: 8px; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .dl:hover { color: var(--ink); }
  @media (max-width: 760px) { .pair { grid-template-columns: 1fr; } }
</style>
