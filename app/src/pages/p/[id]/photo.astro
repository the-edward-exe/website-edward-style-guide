---
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/Button.astro';
import { getProfile } from '../../../lib/profiles';

const profile = await getProfile(Astro.params.id!);
if (!profile) return Astro.rewrite('/404');
const error = Astro.url.searchParams.get('error');
---
<Base title="Photo">
  <div class="layout">
    <section class="upload">
      <span class="label">Step 0 of 4 · {profile.name}</span>
      <h1>Upload one photo</h1>
      <p class="label">Front. Full body. Daylight. Plain background.</p>

      <form method="post" action={`/api/p/${profile.id}/photo`} enctype="multipart/form-data" class="form">
        <label class="drop">
          <img id="preview" alt="" hidden />
          <span id="hint" class="label">Choose a JPG, PNG or WebP photo</span>
          <input id="file" type="file" name="photo" accept="image/jpeg,image/png,image/webp" required />
        </label>
        {error && <p class="error">{error}</p>}
        <Button variant="primary">Upload</Button>
      </form>
    </section>

    <figure class="example">
      <img src="/example-sheet.jpg" alt="Example character sheet" width="896" height="1195" />
      <figcaption class="label">From one photo, Style File builds a sheet like this</figcaption>
    </figure>
  </div>
</Base>

<script>
  const input = document.getElementById('file') as HTMLInputElement;
  const preview = document.getElementById('preview') as HTMLImageElement;
  const hint = document.getElementById('hint')!;
  input.addEventListener('change', () => {
    const f = input.files?.[0];
    if (!f) return;
    preview.src = URL.createObjectURL(f);
    preview.hidden = false;
    hint.textContent = f.name;
  });
</script>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 300px); gap: 48px; align-items: start; }
  .upload { display: flex; flex-direction: column; gap: 12px; max-width: 520px; }
  .form { display: flex; flex-direction: column; gap: 14px; margin-top: 12px; align-items: flex-start; }
  .drop {
    position: relative; width: 100%; aspect-ratio: 3 / 4; max-width: 360px;
    display: flex; align-items: center; justify-content: center; text-align: center;
    background: var(--chip); cursor: pointer; overflow: hidden;
  }
  .drop:hover { outline: 1px solid var(--ink); }
  .drop img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .drop .label { position: relative; padding: 0 16px; }
  .example { margin: 0; }
  .example figcaption { margin-top: 8px; }
  @media (max-width: 760px) { .layout { grid-template-columns: 1fr; } .example { max-width: 260px; } }
</style>
