---
import Base from '../../../layouts/Base.astro';
import Button from '../../../components/Button.astro';
import { getProfile } from '../../../lib/profiles';

const profile = await getProfile(Astro.params.id!);
if (!profile) return Astro.rewrite('/404');
const error = Astro.url.searchParams.get('error');
const v = profile.attempt;
const photoSrc = profile.photoPath ? `/api/p/${profile.id}/image/photo?v=${v}` : '';
const sheetSrc = profile.sheetStatus === 'ready' ? `/api/p/${profile.id}/image/sheet?v=${v}` : '';
---
<Base title="Photo">
  <div class="head">
    <span class="label">Step 0 of 4 · {profile.name}</span>
    <h1>Upload one photo</h1>
    <p class="label">Front. Full body. Daylight. Plain background.</p>
  </div>

  <div class="pair">
    <figure>
      <form method="post" action={`/api/p/${profile.id}/photo`} enctype="multipart/form-data" id="uploadForm">
        <label class="drop" id="drop" data-has={photoSrc ? 'yes' : 'no'}>
          <img id="preview" src={photoSrc || undefined} alt="" hidden={!photoSrc} />
          <span class="prompt" id="prompt" hidden={!!photoSrc}>
            <span class="label strong">Drag a photo here</span>
            <span class="label">or click to browse · JPG, PNG or WebP</span>
          </span>
          <input id="file" type="file" name="photo" accept="image/jpeg,image/png,image/webp" />
        </label>
        <noscript><Button variant="primary">Upload</Button></noscript>
      </form>
      <figcaption class="cap">
        <span class="label">Your photo</span>
        <span class="label link" id="replace" hidden={!photoSrc}>Drop to replace</span>
      </figcaption>
      <p class="error" id="error">{error}</p>
    </figure>

    <figure>
      <div class="frame" id="sheet" data-status={profile.sheetStatus}>
        <img id="sheetImg" src={sheetSrc || undefined} alt={`${profile.name}'s character sheet`} hidden={!sheetSrc} />
        <span class="label" id="sheetMsg" hidden={!!sheetSrc}>
          {profile.sheetStatus === 'pending' ? 'Building your character sheet' :
           profile.sheetStatus === 'failed' ? profile.sheetError : 'Your character sheet appears here'}
        </span>
      </div>
      <figcaption class="cap"><span class="label">Character sheet</span></figcaption>
    </figure>
  </div>

  <div class="actions">
    <a class="btn-next" id="next" href={`/p/${profile.id}/q/1`} hidden={!photoSrc}>Next: the questions</a>
    <span class="label" id="nextNote" hidden={!photoSrc}>The sheet keeps building while you answer.</span>
  </div>
</Base>

<script define:vars={{ id: profile.id, status: profile.sheetStatus, attempt: v }}>
  const drop = document.getElementById('drop');
  const input = document.getElementById('file');
  const preview = document.getElementById('preview');
  const prompt = document.getElementById('prompt');
  const err = document.getElementById('error');
  const sheet = document.getElementById('sheet');
  const sheetImg = document.getElementById('sheetImg');
  const sheetMsg = document.getElementById('sheetMsg');
  const show = (el, on = true) => { el.hidden = !on; };

  function setSheet(state, text) {
    sheet.dataset.status = state;
    if (state === 'ready') {
      sheetImg.src = `/api/p/${id}/image/sheet?t=${Date.now()}`;
      show(sheetImg); show(sheetMsg, false);
    } else {
      show(sheetImg, false); show(sheetMsg);
      sheetMsg.textContent = text;
    }
  }

  let polling = false;
  async function poll() {
    if (polling) return;
    polling = true;
    while (true) {
      const s = await fetch(`/api/p/${id}/status`).then((r) => r.json()).catch(() => null);
      if (s && s.sheetStatus === 'ready') { setSheet('ready'); break; }
      if (s && s.sheetStatus === 'failed') { setSheet('failed', s.sheetError); break; }
      await new Promise((r) => setTimeout(r, 3000));
    }
    polling = false;
  }

  async function upload(file) {
    err.textContent = '';
    preview.src = URL.createObjectURL(file);
    show(preview); show(prompt, false);
    drop.classList.add('busy');
    const body = new FormData();
    body.append('photo', file);
    const res = await fetch(`/api/p/${id}/photo`, { method: 'POST', body, headers: { Accept: 'application/json' } }).catch(() => null);
    drop.classList.remove('busy');
    const out = res ? await res.json().catch(() => null) : null;
    if (!out || !out.ok) {
      err.textContent = out?.error ?? 'UPLOAD FAILED. TRY AGAIN.';
      return;
    }
    document.querySelectorAll('#next, #nextNote, #replace').forEach((el) => show(el));
    setSheet('pending', 'Building your character sheet');
    poll();
  }

  input.addEventListener('change', () => input.files?.[0] && upload(input.files[0]));
  ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (e) => {
    const f = e.dataTransfer?.files?.[0];
    if (f) upload(f);
  });
  // Stop a file dropped beside the box from opening in the tab.
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => e.preventDefault());

  if (status === 'pending') poll();
</script>

<style>
  .head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 28px; }
  .pair { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--gap); align-items: start; max-width: min(820px, calc((100vh - 300px) * 1.15)); }
  figure { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .cap { display: flex; justify-content: space-between; gap: 8px; }
  .drop {
    position: relative; aspect-ratio: 3 / 4; display: flex; align-items: center; justify-content: center; text-align: center;
    background: var(--chip); cursor: pointer; overflow: hidden; outline: 1px dashed var(--muted); outline-offset: -10px;
  }
  .drop[data-has=yes] { outline: none; background: var(--surface); }
  .drop:hover, .drop.over { outline: 2px solid var(--ink); outline-offset: -2px; }
  .drop.busy img { opacity: 0.5; }
  .drop img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .prompt { display: flex; flex-direction: column; gap: 6px; padding: 0 16px; }
  .strong { color: var(--ink); }
  .frame { aspect-ratio: 3 / 4; background: var(--chip); display: flex; align-items: center; justify-content: center; text-align: center; padding: 24px; overflow: hidden; }
  .frame:has(img:not([hidden])) { padding: 0; background: var(--surface); }
  .frame img { width: 100%; height: 100%; object-fit: contain; }
  .frame[data-status=pending] .label { animation: pulse 1.6s ease-in-out infinite; }
  .frame[data-status=failed] .label { color: var(--bad); }
  @keyframes pulse { 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { .frame .label { animation: none !important; } }
  .error:empty { display: none; }
  .actions { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-top: 24px; }
  .btn-next {
    display: inline-flex; padding: 13px 22px; background: var(--accent); color: var(--accent-ink); text-decoration: none;
    font: 500 var(--text-xs)/1 var(--font); text-transform: uppercase; letter-spacing: var(--track-label);
  }
  .btn-next:hover { background: #774c32; }
  @media (max-width: 760px) { .pair { grid-template-columns: 1fr; max-width: 420px; } }
</style>
