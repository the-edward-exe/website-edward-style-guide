---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Questions from '../components/Questions.astro';
import { listProfiles, type Profile } from '../lib/profiles';
import { STEPS } from '../lib/questionnaire';

const profiles = await listProfiles();

function stage(p: Profile): string {
  if (!p.photoPath) return 'Photo needed';
  if (p.sheetApproved) return 'Sheet approved';
  if (p.sheetStatus === 'ready') return 'Sheet ready';
  return 'In progress';
}
const date = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
---
<Base title="Profiles">
  <section class="intro" id="start">
    <span class="label">Personal style file</span>
    <h1>One photo. Twelve questions. Clothes that fit you.</h1>
    <p class="muted">Enter your first name, then drop a photo of yourself into the frame below.</p>
    <label class="field name">
      <span class="label">First name</span>
      <input class="input" id="name" maxlength="40" autocomplete="given-name" />
    </label>
  </section>

  <div class="countbar">
    <span>{profiles.length} {profiles.length === 1 ? 'Profile' : 'Profiles'}</span>
    <span class="muted">Newest first</span>
  </div>

  <div class="grid">
    <div class="card">
      <label class="pic drop" id="drop">
        <img id="preview" alt="" hidden />
        <span class="prompt" id="prompt">
          <span class="label strong">Drop your photo here</span>
          <span class="label">Front. Full body. Daylight.</span>
          <span class="label">or click to browse</span>
        </span>
        <input id="file" type="file" accept="image/jpeg,image/png,image/webp" />
      </label>
      <span class="label" id="dropLabel">New profile</span>
      <span class="name" id="dropName">Your photo</span>
      <span class="error" id="dropError"></span>
    </div>

    {profiles.map((p) => (
      <a class="card" href={`/p/${p.id}`}>
        <div class:list={['pic', { empty: !p.photoPath }]}>
          {p.photoPath && <img src={`/api/p/${p.id}/image/photo?v=${p.attempt}`} alt={p.name} loading="lazy" />}
        </div>
        <span class="label">{stage(p)}</span>
        <span class="name">{p.name}</span>
        <span class="sub">{date(p.createdAt)}</span>
      </a>
    ))}
  </div>

  <dialog id="quiz" aria-labelledby="quizTitle">
    <div class="qhead">
      <div>
        <span class="label" id="quizStep">Step 1 of 4</span>
        <h2 id="quizTitle" tabindex="-1" autofocus>{STEPS[0].title}</h2>
      </div>
      <button class="close label" type="button" id="later">Finish later</button>
    </div>
    <div class="progress" aria-hidden="true">{STEPS.map((s) => <span data-n={s.n} />)}</div>
    <p class="label read" id="readNote"></p>
    <p class="error" id="quizError"></p>

    {STEPS.map((s) => (
      <form class="qstep" data-step={s.n} data-title={s.title} hidden={s.n !== 1}>
        <Questions step={s} />
        <div class="qactions">
          {s.n > 1 ? <button class="back label" type="button" data-back>Back</button> : <span />}
          <Button variant="primary">{s.n === 4 ? 'See my sheet' : 'Next'}</Button>
        </div>
      </form>
    ))}
  </dialog>
</Base>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const nameInput = $<HTMLInputElement>('name');
  const drop = $('drop');
  const fileInput = $<HTMLInputElement>('file');
  const preview = $<HTMLImageElement>('preview');
  const dropError = $('dropError');
  const quiz = $<HTMLDialogElement>('quiz');
  const quizError = $('quizError');
  const readNote = $('readNote');
  const forms = [...document.querySelectorAll<HTMLFormElement>('.qstep')];

  let profileId: string | null = null;
  let pendingFile: File | null = null;
  let busy = false;

  async function postJson(url: string, body: FormData) {
    const res = await fetch(url, { method: 'POST', body, headers: { Accept: 'application/json' } }).catch(() => null);
    return res ? res.json().catch(() => null) : null;
  }

  async function start(file: File) {
    dropError.textContent = '';
    preview.src = URL.createObjectURL(file);
    preview.hidden = false;
    $('prompt').hidden = true;
    const name = nameInput.value.trim();
    if (!name) {
      pendingFile = file;
      dropError.textContent = 'Enter a first name, then press Enter.';
      nameInput.focus();
      return;
    }
    if (busy) return;
    busy = true;
    drop.classList.add('busy');
    $('dropName').textContent = name;
    try {
      if (!profileId) {
        const form = new FormData();
        form.append('name', name);
        const created = await postJson('/api/profiles', form);
        if (!created?.ok) throw new Error(created?.error ?? 'COULD NOT START. TRY AGAIN.');
        profileId = created.id;
      }
      const body = new FormData();
      body.append('photo', file);
      const up = await postJson(`/api/p/${profileId}/photo`, body);
      if (!up?.ok) throw new Error(up?.error ?? 'UPLOAD FAILED. TRY AGAIN.');
      $('dropLabel').textContent = 'Building your character sheet';
      openQuiz();
    } catch (e) {
      dropError.textContent = (e as Error).message;
    } finally {
      busy = false;
      drop.classList.remove('busy');
    }
  }

  function showStep(n: number) {
    forms.forEach((f) => (f.hidden = Number(f.dataset.step) !== n));
    const form = forms[n - 1];
    $('quizStep').textContent = `Step ${n} of 4`;
    $('quizTitle').textContent = form.dataset.title!;
    document.querySelectorAll<HTMLElement>('.progress span').forEach((s) => s.classList.toggle('on', Number(s.dataset.n) <= n));
    readNote.hidden = n !== 2;
    quizError.textContent = '';
    quiz.scrollTop = 0;
  }

  function openQuiz() {
    showStep(1);
    if (!quiz.open) quiz.showModal();
    pollPhotoRead();
  }

  // Fill coloring from Claude's photo read, only where nothing is chosen yet.
  async function pollPhotoRead() {
    readNote.textContent = 'Reading your photo…';
    while (true) {
      const s = await fetch(`/api/p/${profileId}/status`).then((r) => r.json()).catch(() => null);
      if (s && s.photoReadStatus !== 'pending') {
        let filled = false;
        const r = s.photoRead;
        if (r) {
          const tone = [...document.querySelectorAll<HTMLInputElement>('#quiz input[name=skinTone]')];
          if (!tone.some((t) => t.checked)) tone.forEach((t) => { if (t.value === String(r.skinTone)) { t.checked = true; filled = true; } });
          for (const k of ['hair', 'eyes']) {
            const el = document.querySelector<HTMLInputElement>(`#quiz input[name=${k}]`);
            if (el && !el.value) { el.value = r[k]; filled = true; }
          }
        }
        readNote.textContent = filled ? 'From your photo. Change if wrong.' : '';
        return;
      }
      await new Promise((res) => setTimeout(res, 2000));
    }
  }

  forms.forEach((form) => {
    const n = Number(form.dataset.step);
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      form.querySelectorAll('.q').forEach((q) => q.classList.remove('bad'));
      const out = await postJson(`/api/p/${profileId}/answers?step=${n}`, new FormData(form));
      if (!out) { quizError.textContent = 'Could not save. Try again.'; return; }
      if (!out.ok) {
        quizError.textContent = 'Answer every question to continue.';
        form.querySelectorAll<HTMLElement>('.q').forEach((q) => {
          if (q.dataset.keys!.split(',').some((k) => out.missing.includes(k))) q.classList.add('bad');
        });
        return;
      }
      if (n === 4) location.href = out.next;
      else showStep(n + 1);
    });
    form.querySelector('[data-back]')?.addEventListener('click', () => showStep(n - 1));
  });

  // "Finish later" keeps everything saved; the card on the home screen picks up where they left off.
  $('later').addEventListener('click', () => { quiz.close(); location.reload(); });
  quiz.addEventListener('cancel', (e) => e.preventDefault());

  fileInput.addEventListener('change', () => fileInput.files?.[0] && start(fileInput.files[0]));
  ['dragenter', 'dragover'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.add('over'); }));
  ['dragleave', 'drop'].forEach((t) => drop.addEventListener(t, (e) => { e.preventDefault(); drop.classList.remove('over'); }));
  drop.addEventListener('drop', (e) => { const f = (e as DragEvent).dataTransfer?.files?.[0]; if (f) start(f); });
  window.addEventListener('dragover', (e) => e.preventDefault());
  window.addEventListener('drop', (e) => e.preventDefault());
  nameInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && pendingFile && nameInput.value.trim()) { const f = pendingFile; pendingFile = null; start(f); }
  });
</script>

<style>
  .intro { display: flex; flex-direction: column; gap: 14px; padding-bottom: 36px; margin-bottom: 8px; border-bottom: 1px solid var(--line); }
  .intro > * { max-width: 520px; }
  .name.field { max-width: 320px; margin-top: 4px; }

  .drop { position: relative; display: flex; align-items: center; justify-content: center; text-align: center; cursor: pointer; outline: 1px dashed var(--muted); outline-offset: -12px; background: var(--chip); }
  .drop:hover, .drop.over { outline: 2px solid var(--ink); outline-offset: -2px; }
  .drop:has(img:not([hidden])) { outline: none; background: var(--surface); }
  .drop.busy img { opacity: 0.5; }
  .drop img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .prompt { display: flex; flex-direction: column; gap: 6px; padding: 0 16px; }
  .strong { color: var(--ink); font-size: var(--text-sm); }
  .card .error:empty { display: none; }

  dialog {
    width: min(760px, calc(100vw - 32px)); max-height: 88vh; padding: 28px 32px 24px;
    border: 0; border-radius: var(--radius); background: var(--bg); color: var(--ink);
    overflow-y: auto; margin: auto;
  }
  dialog::backdrop { background: rgb(29 41 56 / 0.55); }
  .qhead { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .qhead h2 { font-size: var(--text-lg); margin-top: 6px; outline: none; }
  .close { background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; padding: 4px 0; font-family: var(--font); }
  .close:hover { color: var(--ink); }
  .progress { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; margin: 14px 0 6px; }
  .progress span { height: 2px; background: var(--line); }
  .progress span.on { background: var(--ink); }
  .read { color: var(--ok); min-height: 1em; margin: 6px 0; }
  #quizError:empty { display: none; }
  .qactions { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--line); padding-top: 18px; }
  .back { background: none; border: 0; cursor: pointer; font-family: var(--font); }
  .back:hover { color: var(--ink); text-decoration: underline; }
  @media (max-width: 560px) { dialog { padding: 20px 16px; max-height: 92vh; } }
</style>
