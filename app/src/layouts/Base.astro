---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
interface Props { title: string; right?: { href: string; label: string } }
const { title, right } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | Style File</title>
  </head>
  <body>
    <TopBar right={right} />
    <main class="page"><slot /></main>
  </body>
</html>
