---
import Button from './Button.astro';
import { amazonUrl } from '../lib/shop';
import { STYLE_OPTIONS } from '../lib/looks';
import { OUTFIT_COUNT, SEASONS, canMakeOutfits, latestOutfitRun, listOutfits } from '../lib/outfits';
import { aiMode } from '../lib/ai/mode';
import type { Profile } from '../lib/profiles';

interface Props { profile: Profile }
const { profile } = Astro.props;

const canMake = canMakeOutfits(profile);
const [run, outfits] = await Promise.all([latestOutfitRun(profile.id), listOutfits(profile.id)]);
const writing = run?.status === 'pending';
const painting = outfits.some((o) => o.status === 'pending');
const busy = writing || painting;
const failedRun = run?.status === 'failed' ? run : null;

// The form starts from a failed run's picks, otherwise every season and the person's own tastes.
const pickedSeasons = new Set<string>(failedRun?.seasons ?? SEASONS);
const pickedStyles = new Set<string>(failedRun?.styles ?? profile.answers.styles ?? []);

// The library, filed by season, then by style.
const styleOrder = STYLE_OPTIONS.map((o) => o.label);
const library = SEASONS.map((season) => {
  const inSeason = outfits.filter((o) => o.season === season);
  return {
    season,
    count: inSeason.length,
    styles: styleOrder.filter((style) => inSeason.some((o) => o.style === style))
      .map((style) => ({ style, outfits: inSeason.filter((o) => o.style === style) })),
  };
}).filter((s) => s.count > 0);
const version = (path: string | null) => path?.match(/outfit-(\d+)/)?.[1] ?? '';
const demo = aiMode();
---
<section class="outfits" id="outfits">
  <div class="head">
    <span class="label">New Outfits</span>
    <h2>Make new outfits</h2>
    <p class="lead">Your photo, character sheet and answers are already saved. Pick what you need and we'll dress you again.</p>
    {(demo.claude === 'demo' || demo.gemini === 'demo') && <p class="note-warn">Demo mode: outfits use placeholder text or pictures until the API keys are in .env</p>}
  </div>

  {canMake ? (
  <form method="post" action={`/api/p/${profile.id}/outfits`} class="maker" id="maker">
    <fieldset disabled={busy}>
      <legend class="label">Seasons</legend>
      <div class="picks">
        {SEASONS.map((s) => (
          <label class="pick"><input type="checkbox" name="season" value={s} checked={pickedSeasons.has(s)} /><span>{s}</span></label>
        ))}
      </div>
    </fieldset>
    <fieldset disabled={busy}>
      <legend class="label">Styles</legend>
      <div class="picks">
        {STYLE_OPTIONS.map((o) => (
          <label class="pick"><input type="checkbox" name="style" value={o.value} checked={pickedStyles.has(o.value)} /><span>{o.label}</span></label>
        ))}
      </div>
    </fieldset>
    <div class="go">
      {!busy && <Button variant="primary">Make {OUTFIT_COUNT} outfits</Button>}
      <p class="label" id="makerHint">{busy ? (writing ? 'Writing your outfits.' : 'Dressing you. Pictures take a minute or two.') : `${OUTFIT_COUNT} outfits, split evenly across what you pick. They add to your library below.`}</p>
    </div>
  </form>
  ) : <p class="muted">You can make new outfits once your character sheet is ready.</p>}
  {busy && (
    <form method="post" action={`/api/p/${profile.id}/stop`} class="stop" id="outfitStop">
      <input type="hidden" name="what" value="outfits" />
      <Button>Stop</Button>
    </form>
  )}
  {failedRun && <p class="error runerror">{failedRun.error}</p>}

  <section class="library" aria-label="Your outfits">
    <div class="lhead">
      <a class="label link" id="outfitZip" href={`/api/p/${profile.id}/outfits/zip`} hidden={!outfits.some((o) => o.status === 'ready')}>Download all</a>
    </div>

    {writing && (
      <div class="grid">
        {Array.from({ length: OUTFIT_COUNT }, () => <div class="frame waiting"><span class="label pulse">Writing your outfits</span></div>)}
      </div>
    )}

    {outfits.length === 0 && !writing && <p class="muted">No outfits yet. Your first {OUTFIT_COUNT} will appear here, filed by season and style.</p>}

    {library.map((s) => (
      <section class="season" data-season={s.season}>
        <div class="shead"><h3>{s.season}</h3><span class="label">{s.count} {s.count === 1 ? 'outfit' : 'outfits'}</span></div>
        {s.styles.map((g) => (
          <div class="stylegroup" data-style={g.style}>
            <h4 class="label">{g.style}</h4>
            <ol class="grid">
              {g.outfits.map((o) => (
                <li class="card" id={`outfit-${o.id}`}>
                  <div class="shot">
                  <div class:list={['frame', { waiting: o.status !== 'ready' }]} data-id={o.id} data-status={o.status} data-replacing={String(o.replacing)} data-v={version(o.path)} data-alt={`${profile.name} wearing ${o.look.name}`}>
                    {o.status === 'ready' && <img src={`/api/p/${profile.id}/outfits/${o.id}?v=${version(o.path)}`} alt={`${profile.name} wearing ${o.look.name}`} loading="lazy" />}
                    {o.status === 'pending' && <span class="label pulse">{o.replacing ? 'Making a new outfit' : 'Dressing you'}</span>}
                    {o.status === 'failed' && (
                      <>
                        <span class="error">{o.error}</span>
                        <form method="post" action={`/api/p/${profile.id}/outfits/${o.id}`}><Button>Try again</Button></form>
                      </>
                    )}
                  </div>
                  <form class="x" method="post" action={`/api/p/${profile.id}/outfits/${o.id}/replace`} hidden={o.status === 'pending' || o.replacing}>
                    <button type="submit" aria-label={`Remove ${o.look.name} and make a new outfit`} title="Remove and make a new one">×</button>
                  </form>
                  </div>
                  <div class="meta">
                    <span class="label">{o.season} · {o.style}</span>
                    <a class="label link" href={`/api/p/${profile.id}/outfits/${o.id}?download=1`} hidden={o.status !== 'ready'}>Download</a>
                  </div>
                  {!o.replacing && (<>
                  <span class="name">{o.look.name}</span>
                  <ul class="pieces">{o.look.pieces.map((pc) => <li><i style={`background:${pc.hex}`} /><a href={amazonUrl(pc, profile.answers.section)} target="_blank" rel="noopener noreferrer" aria-label={`Shop ${pc.color} ${pc.item} on Amazon (opens in a new tab)`}>{pc.item}</a><em>{pc.color}</em></li>)}</ul>
                  <p class="why">{o.look.why}</p>
                  </>)}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))}
  </section>
</section>

<script define:vars={{ id: profile.id, runStatus: run?.status ?? null, total: outfits.length }}>
  const frames = () => [...document.querySelectorAll('.frame[data-id]')];

  // The button needs at least one season and one style.
  const maker = document.getElementById('maker');
  const hint = document.getElementById('makerHint');
  const hintText = hint?.textContent;
  const submit = maker?.querySelector('button[type=submit]');
  function checkPicks() {
    if (!submit) return;
    const ok = maker.querySelector('[name=season]:checked') && maker.querySelector('[name=style]:checked');
    submit.disabled = !ok;
    hint.textContent = ok ? hintText : 'Pick at least one season and one style.';
  }
  maker?.addEventListener('change', checkPicks);
  checkPicks();

  // Pictures swap in place as each one lands. A finished batch or a failure needs the server's version of the page.
  function paint(frame, o) {
    if (o.status === 'failed') return location.reload();
    frame.dataset.status = o.status;
    frame.dataset.v = o.v ?? '';
    frame.classList.toggle('waiting', o.status !== 'ready');
    frame.replaceChildren();
    if (o.status === 'ready') {
      const img = document.createElement('img');
      img.src = `/api/p/${id}/outfits/${o.id}?v=${o.v}`;
      img.alt = frame.dataset.alt;
      frame.append(img);
    }
    const card = frame.closest('.card');
    const dl = card.querySelector('.meta a');
    card.querySelector('.x').hidden = o.status !== 'ready';
    if (dl) dl.hidden = o.status !== 'ready';
    const zip = document.getElementById('outfitZip');
    if (zip && o.status === 'ready') zip.hidden = false;
  }

  const busy = () => runStatus === 'pending' || frames().some((f) => f.dataset.status === 'pending');
  const poll = async () => {
    const s = await fetch(`/api/p/${id}/outfits`).then((r) => r.json()).catch(() => null);
    if (s) {
      if ((s.run?.status ?? null) !== runStatus || s.outfits.length !== total) return location.reload();
      for (const frame of frames()) {
        const o = s.outfits.find((x) => x.id === frame.dataset.id);
        if (o && String(o.replacing) !== frame.dataset.replacing) return location.reload();
        if (o && (o.status !== frame.dataset.status || (o.v ?? '') !== frame.dataset.v)) paint(frame, o);
      }
      // The last picture landed: bring back the form.
      if (!busy()) return location.reload();
    }
    setTimeout(poll, 3000);
  };
  if (busy()) setTimeout(poll, 3000);
</script>

<style>
  .outfits { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .head { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; margin-bottom: 28px; }
  .lead { font-size: var(--text-md); color: var(--ink); max-width: 560px; }
  .link { text-decoration: underline; text-underline-offset: 4px; }
  .link:hover { color: var(--ink); }

  .maker { display: flex; flex-direction: column; gap: 20px; padding: 24px; background: var(--surface); }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
  fieldset:disabled { opacity: 0.55; }
  legend { padding: 0; margin-bottom: 10px; }
  .picks { display: flex; gap: 6px; flex-wrap: wrap; }
  .pick { position: relative; cursor: pointer; }
  fieldset:disabled .pick { cursor: default; }
  .pick input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: inherit; }
  .pick span {
    display: block; font: 500 var(--text-xs)/1 var(--font); text-transform: uppercase; letter-spacing: var(--track-label);
    padding: 11px 14px; background: var(--chip); color: var(--ink);
  }
  .pick input:checked + span { background: var(--ink); color: var(--bg); }
  .pick input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .go { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .stop { margin-top: 12px; }
  .runerror { margin-top: 12px; }

  .library { margin-top: 44px; }
  .lhead { display: flex; justify-content: flex-end; margin-bottom: 10px; }

  .season { padding-top: 28px; margin-top: 20px; border-top: 1px solid var(--line); }
  .shead { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 16px; }
  .shead h3 { font-size: var(--text-lg); font-weight: 500; text-transform: uppercase; letter-spacing: var(--track-label); }
  .stylegroup { margin-bottom: 28px; }
  .stylegroup h4 { margin: 0 0 10px; font-weight: 500; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--gap); }
  .card { display: flex; flex-direction: column; gap: 8px; min-width: 0; scroll-margin-top: 20px; }
  .shot { position: relative; }
  .x {
    position: absolute; top: 6px; right: 6px; margin: 0;
  }
  .x button {
    display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; padding: 0; border: 1px solid var(--line);
    background: var(--surface); color: var(--ink); font: 500 1.05rem/1 var(--font); cursor: pointer;
  }
  .x button:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .frame { background: var(--surface); aspect-ratio: 3 / 4; display: flex; flex-direction: column; gap: 12px; align-items: center; justify-content: center; overflow: hidden; }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .frame.waiting { background: var(--chip); padding: 16px; text-align: center; }
  .pulse { animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.4; } }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-top: 4px; }
  .name { text-transform: uppercase; letter-spacing: var(--track-label); font-size: var(--text-sm); font-weight: 500; }
  .pieces { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: var(--text-xs); }
  .pieces li { display: flex; align-items: center; gap: 6px; }
  .pieces em { font-style: normal; color: var(--muted); }
  .pieces a { text-decoration: underline; text-underline-offset: 3px; }
  .pieces a:hover { color: var(--accent); }
  .pieces i { width: 10px; height: 10px; flex: none; border: 1px solid var(--line); }
  .why { margin: 0; font-size: var(--text-xs); color: var(--muted); }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .maker { padding: 16px; } }
  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
</style>
