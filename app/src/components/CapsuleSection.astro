---
import type { Profile } from '../lib/profiles';

interface Props { profile: Profile }
const { profile } = Astro.props;
const capsule = profile.guide?.capsule ?? [];
const owned = new Set(profile.capsuleOwned);
---
{capsule.length > 0 && (
  <section class="capsule-block" id="capsule-section" data-profile={profile.id} aria-labelledby="capsuleTitle">
    <div class="bhead">
      <h2 id="capsuleTitle">Capsule</h2>
      <span class="label">Tick what you own. Ticked pieces are left out of new outfits and pictures.</span>
    </div>
    <div class="capsule" id="capsule">
      {capsule.map((c, i) => (
        <label class="capitem">
          <input type="checkbox" value={i} checked={owned.has(i)} />
          <span>{c.item}</span>
          <span class="label">{c.category}</span>
        </label>
      ))}
    </div>
    <p class="error" id="capsuleError" role="alert" hidden>Could not save. Try again.</p>
  </section>
)}

<script>
  // The checklist saves on every tick.
  const section = document.getElementById('capsule-section');
  section?.addEventListener('change', async () => {
    const owned = [...section.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => Number(i.value));
    const res = await fetch(`/api/p/${section.dataset.profile}/capsule`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ owned }),
    }).catch(() => null);
    document.getElementById('capsuleError')!.hidden = !!res?.ok;
  });
</script>

<style>
  .capsule-block { padding-bottom: 28px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }
  .bhead { display: flex; justify-content: space-between; align-items: baseline; gap: 6px 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .capsule { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 28px; }
  .capitem { display: flex; gap: 10px; align-items: baseline; padding: 8px 0; border-bottom: 1px dashed var(--line); cursor: pointer; font-size: var(--text-sm); }
  .capitem input { accent-color: var(--accent); }
  .capitem .label { margin-left: auto; }
  .error { margin-top: 10px; }
  @media (max-width: 900px) { .capsule { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .capsule { grid-template-columns: 1fr; } }
</style>
